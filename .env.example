# ==============================================
# DATABASE CONFIGURATION
# ==============================================
# Pour Docker local avec PostgreSQL
DATABASE_URL="postgresql://shiftuser:admin123@postgres:5432/shift_manager"

# Pour Prisma Accelerate (production hébergée)
# DATABASE_URL="prisma+postgres://accelerate.prisma-data.net/?api_key=YOUR_API_KEY"

# Configuration PostgreSQL (utilisé par docker-compose)
POSTGRES_USER=shiftuser
POSTGRES_PASSWORD=admin123
POSTGRES_DB=shift_manager

# ==============================================
# AZURE AD / MICROSOFT GRAPH - SERVER SIDE
# ==============================================
AZURE_AD_CLIENT_ID="your-azure-client-id"
AZURE_AD_CLIENT_SECRET="your-azure-client-secret"
AZURE_AD_TENANT_ID="your-azure-tenant-id"
MICROSOFT_GRAPH_REFRESH_TOKEN=""

# ==============================================
# AZURE AD - CLIENT SIDE (NEXT_PUBLIC_)
# ==============================================
NEXT_PUBLIC_AZURE_AD_CLIENT_ID="your-azure-client-id"
NEXT_PUBLIC_AZURE_AD_TENANT_ID="your-azure-tenant-id"
NEXT_PUBLIC_AZURE_AD_REDIRECT_URI="http://localhost:3000"

# ==============================================
# CRON JOB SECURITY
# ==============================================
# Générez un secret aléatoire sécurisé (ex: openssl rand -base64 32)
CRON_SECRET="your-secure-random-secret-change-this-in-production"
NEXT_PUBLIC_CRON_SECRET="your-secure-random-secret-change-this-in-production"

# ==============================================
# APPLICATION
# ==============================================
NEXT_PUBLIC_URL="http://localhost:3000"
APP_PORT=3000
NODE_ENV=production

# ==============================================
# NOTES IMPORTANTES
# ==============================================
# 1. Copiez ce fichier vers .env et remplissez les valeurs réelles
# 2. Ne commitez JAMAIS le fichier .env dans Git
# 3. Pour générer un CRON_SECRET sécurisé: openssl rand -base64 32
# 4. Pour la production, changez toutes les URLs localhost vers votre domaine réel
# 5. Pour Docker, DATABASE_URL doit pointer vers 'postgres' (nom du service)
