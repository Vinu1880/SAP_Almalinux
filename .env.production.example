# ==============================================
# PRODUCTION ENVIRONMENT CONFIGURATION
# ==============================================
# ⚠️ IMPORTANT: Changez TOUTES les valeurs par défaut !
# Ne copiez pas ce fichier tel quel en production !

# ==============================================
# DATABASE CONFIGURATION
# ==============================================
# Pour Docker avec PostgreSQL
DATABASE_URL="postgresql://shiftuser:CHANGEZ_CE_MOT_DE_PASSE@postgres:5432/shift_manager"

# Configuration PostgreSQL
POSTGRES_USER=shiftuser
POSTGRES_PASSWORD=CHANGEZ_CE_MOT_DE_PASSE
POSTGRES_DB=shift_manager

# ==============================================
# AZURE AD / MICROSOFT GRAPH - SERVER SIDE
# ==============================================
AZURE_AD_CLIENT_ID="votre-azure-client-id-reel"
AZURE_AD_CLIENT_SECRET="votre-azure-client-secret-reel"
AZURE_AD_TENANT_ID="votre-azure-tenant-id-reel"
MICROSOFT_GRAPH_REFRESH_TOKEN=""

# ==============================================
# AZURE AD - CLIENT SIDE (NEXT_PUBLIC_)
# ==============================================
NEXT_PUBLIC_AZURE_AD_CLIENT_ID="votre-azure-client-id-reel"
NEXT_PUBLIC_AZURE_AD_TENANT_ID="votre-azure-tenant-id-reel"
NEXT_PUBLIC_AZURE_AD_REDIRECT_URI="https://votre-domaine.com"

# ==============================================
# CRON JOB SECURITY
# ==============================================
# ⚠️ GÉNÉREZ avec: openssl rand -base64 32
CRON_SECRET="GENEREZ_UN_SECRET_SECURISE_ICI"
NEXT_PUBLIC_CRON_SECRET="GENEREZ_UN_SECRET_SECURISE_ICI"

# ==============================================
# APPLICATION
# ==============================================
NEXT_PUBLIC_URL="https://votre-domaine.com"
APP_PORT=3000
NODE_ENV=production

# ==============================================
# CHECKLIST DE SÉCURITÉ PRODUCTION
# ==============================================
# ✅ Tous les mots de passe ont été changés
# ✅ Les secrets ont été générés aléatoirement
# ✅ Les URLs pointent vers le domaine de production
# ✅ HTTPS est configuré
# ✅ Firewall est configuré
# ✅ Sauvegardes automatiques sont configurées
# ✅ Ce fichier n'est PAS commité dans Git
