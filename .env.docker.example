# =============================================
# Variables d'environnement pour Docker
# Copier ce fichier vers .env et remplir les valeurs
# =============================================

# Base de données PostgreSQL
# (utilise le service db du docker-compose par défaut)
DATABASE_URL=postgresql://postgres:postgres@db:5432/autoplanner?schema=public

# Azure AD Configuration (SSO Microsoft)
NEXT_PUBLIC_AZURE_AD_CLIENT_ID=votre-client-id
NEXT_PUBLIC_AZURE_AD_TENANT_ID=votre-tenant-id
AZURE_AD_CLIENT_SECRET=votre-client-secret

# Node
NODE_ENV=production
