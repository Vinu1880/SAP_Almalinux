// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlserver"
  url      = env("DATABASE_URL")
}

model User {
  id            String      @id @default(cuid())
  email         String      @unique
  firstName     String
  lastName      String
  phone         String?
  location      String?
  role          String?
  workPercent   Int         @default(100)
  status        String      @default("ACTIVE") // ACTIVE, INACTIVE
  notes         String?
  piketts       Pikett[]
  // CHAMPS pour la rotation et disponibilité (stockés comme JSON sérialisé)
  rotationConfig String?    // Stocke la configuration de rotation directement
  availability   String?    // Stocke les disponibilités hebdomadaires

  teamId        String?
  team          Team?       @relation("TeamMembers", fields: [teamId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  leadingTeam   Team?       @relation("TeamLead")

  assignments   ShiftAssignment[]
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([email])
  @@index([teamId])
}

// Ajouter un modèle pour stocker les patterns de rotation
model RotationPattern {
  id          String   @id @default(cuid())
  name        String
  description String?
  cycleLength Int
  weeks       String   // Stocke les patterns de semaine (JSON sérialisé)
  userShifts  String?  // IDs des shifts associés à ce pattern (JSON sérialisé)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([name])
}

model Team {
  id          String   @id @default(cuid())
  name        String
  description String?
  color       String   @default("#3b82f6")

  leadId      String?  @unique
  lead        User?    @relation("TeamLead", fields: [leadId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  members     User[]   @relation("TeamMembers")
  shifts      Shift[]
  piketts     Pikett[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([name])
}

model Pikett {
  id              String   @id @default(cuid())
  name            String
  description     String?
  startWeek       String   // Format: "2025-W03"
  daysOfWeek      String   @default("[1,2,3,4,5]") // JSON sérialisé - Lun=1, Mar=2, etc. Dim=0
  endWeek         String?  // Si null, pikett permanent
  color           String   @default("#dc2626")
  status          String   @default("ACTIVE") // ACTIVE, INACTIVE, ARCHIVED
  is24_7          Boolean  @default(true)

  // Relations
  teamId          String
  team            Team     @relation(fields: [teamId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  // Relation optionnelle avec User (pour la relation inverse)
  userId          String?
  user            User?    @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  // Listes d'IDs pour inclusion/exclusion (JSON sérialisé)
  includedUserIds String   @default("[]")
  excludedUserIds String   @default("[]")

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([teamId])
  @@index([status])
  @@index([startWeek])
  @@index([userId])
}

model Shift {
  id             String   @id @default(cuid())
  name           String
  description    String?
  startTime      String   // Format HH:MM
  endTime        String   // Format HH:MM
  daysOfWeek     String   @default("[1,2,3,4,5]") // JSON sérialisé - Lun=1, Mar=2, etc. Dim=0
  membersRequired Int     @default(1)
  priority       String   @default("MEDIUM") // LOW, MEDIUM, HIGH, CRITICAL
  status         String   @default("ACTIVE") // ACTIVE, INACTIVE, ARCHIVED
  color          String   @default("#3b82f6")
  senderMailbox  String   @default("") // Shared mailbox pour l'envoi des invitations

  // Listes d'IDs pour inclusion/exclusion (JSON sérialisé)
  includedUserIds String  @default("[]")
  excludedUserIds String  @default("[]")

  teamId         String
  team           Team     @relation(fields: [teamId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  assignments    ShiftAssignment[]
  usageCount     Int      @default(0)
  lastUsedAt     DateTime?

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([teamId])
  @@index([status])
}

model ShiftAssignment {
  id              String   @id @default(cuid())
  date            DateTime
  status          String   @default("PENDING") // PENDING, ACCEPTED, REFUSED, CANCELLED
  reason          String?
  respondedAt     DateTime?
  outlookEventId  String?  // ID de l'événement Outlook pour synchronisation
  resent          Boolean  @default(false) // Indique si c'est un resend
  resentAt        DateTime?// Date du resend

  shiftId         String
  shift           Shift    @relation(fields: [shiftId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([date, shiftId, userId])
  @@index([userId])
  @@index([shiftId])
  @@index([date])
  @@index([status])
  @@index([outlookEventId])
}

model OutOfOfficeEvent {
  id           String   @id @default(cuid())
  userEmail    String
  subject      String
  startDate    DateTime
  endDate      DateTime
  isAllDay     Boolean  @default(false)
  outlookId    String?  @unique
  calendarName String?
  syncedAt     DateTime @default(now())

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([userEmail])
  @@index([startDate, endDate])
}

model AuditLog {
  id        String   @id @default(cuid())
  action    String
  entity    String
  entityId  String?
  userId    String?
  data      String?  // JSON sérialisé
  createdAt DateTime @default(now())

  @@index([entity])
  @@index([userId])
  @@index([createdAt])
}

model Holiday {
  id          String   @id @default(cuid())
  name        String
  date        DateTime
  cantons     String   @default("[]") // JSON sérialisé - ['BE', 'ZH', 'VD', 'ALL']
  type        String   // FEDERAL, CANTONAL, CUSTOM
  recurring   Boolean  @default(false)
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("holidays")
}
