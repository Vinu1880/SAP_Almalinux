// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String      @id @default(cuid())
  email         String      @unique
  firstName     String
  lastName      String
  phone         String?
  location      String?
  role          String?
  workPercent   Int         @default(100)
  status        UserStatus  @default(ACTIVE)
  notes         String?
  piketts       Pikett[]
  rotationConfig Json?      // Rotation config for this user
  availability   Json?      // Weekly availability

  teamId        String?
  team          Team?       @relation("TeamMembers", fields: [teamId], references: [id])
  leadingTeam   Team?       @relation("TeamLead")
  
  assignments        ShiftAssignment[]
  pikettAssignments  PikettAssignment[]
  sentShiftAssignments   ShiftAssignment[]  @relation("SentShiftAssignments")
  sentPikettAssignments  PikettAssignment[] @relation("SentPikettAssignments")
  rules              UserRule[]
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([email])
  @@index([teamId])
}

model RotationPattern {
  id          String   @id @default(cuid())
  name        String
  description String?
  cycleLength Int
  weeks       Json     // Weekly pattern definition
  userShifts  Json?    // Shift IDs associated with this pattern

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([name])
}

model Team {
  id          String   @id @default(cuid())
  name        String
  description String?
  color       String   @default("#3b82f6")
  
  leadId      String?  @unique
  lead        User?    @relation("TeamLead", fields: [leadId], references: [id])
  members     User[]   @relation("TeamMembers")
  shifts      Shift[]
  piketts     Pikett[]
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  @@index([name])
}

model Pikett {
  id              String   @id @default(cuid())
  name            String
  description     String?
  startWeek       String   // Format: "2025-W03"
  endWeek         String?  // Null = permanent pikett
  color           String   @default("#dc2626")
  status          Status   @default(ACTIVE)
  is24_7          Boolean  @default(true)
  senderMailbox   String   @default("") // Shared mailbox for invitations
  startHour       String   @default("08:00") // Shift-change hour (Mon startHour → next Mon startHour)
  minRestWeeks    Int      @default(3) // Legal min weeks between two pikett weeks
  avoidSupportSameWeek Boolean @default(true) // Skip support shifts during a pikett week

  teamId          String
  team            Team     @relation(fields: [teamId], references: [id])

  userId          String?
  user            User?    @relation(fields: [userId], references: [id])

  includedUserIds String[]
  excludedUserIds String[]
  
  assignments     PikettAssignment[]

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([teamId])
  @@index([status])
  @@index([startWeek])
  @@index([userId])
}

model Shift {
  id             String   @id @default(cuid())
  name           String
  description    String?
  startTime      String   // HH:MM
  endTime        String   // HH:MM
  daysOfWeek     Int[]    @default([1, 2, 3, 4, 5]) // Sun=0, Mon=1...
  membersRequired      Int     @default(1)
  minConsecutiveDays   Int     @default(1)
  priority             Priority @default(MEDIUM)
  status         Status   @default(ACTIVE)
  color          String   @default("#3b82f6")
  senderMailbox  String   @default("") // Shared mailbox for invitations

  includedUserIds String[]
  excludedUserIds String[]

  teamId         String
  team           Team     @relation(fields: [teamId], references: [id])
  
  assignments    ShiftAssignment[]
  usageCount     Int      @default(0)
  lastUsedAt     DateTime?
  
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  
  @@index([teamId])
  @@index([status])
}

model ShiftAssignment {
  id              String           @id @default(cuid())
  date            DateTime
  status          AssignmentStatus @default(PENDING)
  reason          String?
  respondedAt     DateTime?
  outlookEventId  String?          // Outlook event id for sync
  resent          Boolean          @default(false) // Was reassigned to someone else
  resentAt        DateTime?
  resentFromId    String?          // Original refused assignment id

  shiftId         String
  shift           Shift            @relation(fields: [shiftId], references: [id], onDelete: Cascade)

  userId          String
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  sentById        String?
  sentBy          User?            @relation("SentShiftAssignments", fields: [sentById], references: [id], onDelete: SetNull)

  // Split shift: a slot cut into time segments held by different people.
  // Null on regular assignments.
  segmentStart    String?          // "08:00"
  segmentEnd      String?          // "12:30"
  segmentGroupId  String?          // shared by every segment of one split
  segmentIndex    Int?             // 1-based position within the split

  // People copied on the invitation as optional attendees. Purely
  // informational: they see the slot but carry none of its weight, so they are
  // ignored by MAX_LOAD, fairness and the same-day block. Plain user ids, no
  // relation, since nothing here is ever joined on.
  ccUserIds       String[]         @default([])

  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  // Uniqueness is enforced by a SQL expression index Prisma cannot express:
  //   UNIQUE (date, shiftId, userId, COALESCE(segmentIndex, 0))
  // A plain @@unique on segmentIndex would let unsplit rows duplicate freely,
  // because Postgres treats NULLs as distinct in unique indexes.
  // Create it once per environment (see docs-internal), it is not in db push.
  @@index([userId])
  @@index([shiftId])
  @@index([date])
  @@index([status])
  @@index([outlookEventId])
  @@index([resentFromId])
  @@index([segmentGroupId])
  @@index([sentById])
}

model PikettAssignment {
  id              String           @id @default(cuid())
  date            DateTime
  status          AssignmentStatus @default(PENDING)
  reason          String?
  respondedAt     DateTime?
  outlookEventId  String?
  resent          Boolean          @default(false)
  resentAt        DateTime?
  resentFromId    String?

  pikettId        String
  pikett          Pikett           @relation(fields: [pikettId], references: [id], onDelete: Cascade)

  userId          String
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  sentById        String?
  sentBy          User?            @relation("SentPikettAssignments", fields: [sentById], references: [id], onDelete: SetNull)

  // Optional attendees on the invitation — see ShiftAssignment.ccUserIds.
  ccUserIds       String[]         @default([])

  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@unique([date, pikettId, userId])
  @@index([userId])
  @@index([pikettId])
  @@index([date])
  @@index([status])
  @@index([outlookEventId])
  @@index([resentFromId])
  @@index([sentById])
}

model OutOfOfficeEvent {
  id           String   @id @default(cuid())
  userEmail    String
  subject      String
  startDate    DateTime
  endDate      DateTime
  isAllDay     Boolean  @default(false)
  outlookId    String?  @unique
  calendarName String?
  syncedAt     DateTime @default(now())
  
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  
  @@index([userEmail])
  @@index([startDate, endDate])
}

model BackupSchedule {
  id           String   @id @default(cuid())
  enabled      Boolean  @default(false)
  frequency    String   @default("daily") // daily | weekly | monthly
  hour         String   @default("02:00") // HH:MM
  dayOfWeek    Int      @default(1)       // 0=Sun..6=Sat (weekly)
  dayOfMonth   Int      @default(1)       // (monthly)
  maxBackups   Int      @default(10)
  lastRunAt    DateTime?
  updatedAt    DateTime @updatedAt
  createdAt    DateTime @default(now())
}

model AuditLog {
  id        String   @id @default(cuid())
  action    String
  entity    String
  entityId  String?
  userId    String?
  data      Json?
  createdAt DateTime @default(now())
  
  @@index([entity])
  @@index([userId])
  @@index([createdAt])
}

model Holiday {
  id          String   @id @default(cuid())
  name        String
  date        DateTime
  cantons     String[] // e.g. ['BE', 'ZH', 'VD', 'ALL']
  type        HolidayType
  recurring   Boolean  @default(false)
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("holidays")
}

enum UserStatus {
  ACTIVE
  INACTIVE
}

enum Status {
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum AssignmentStatus {
  PENDING
  TENTATIVE
  ACCEPTED
  REFUSED
  CANCELLED
}

enum HolidayType {
  FEDERAL
  CANTONAL
  CUSTOM
}

enum UserRuleType {
  WEEK_PARITY
  DOUBLE_SHIFT
  MAX_LOAD
}

model UserRule {
  id        String       @id @default(cuid())
  userId    String
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      UserRuleType
  config    Json
  enabled   Boolean      @default(true)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@index([userId])
}